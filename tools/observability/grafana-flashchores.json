  {
   "type": "stat",
   "id": 12,
   "title": "CPU",
   "description": "Of the 2 processors the JVM is told it has.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 16,
