    "overrides": []
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "sum(increase(vaadin_errors_total[1h])) or vector(0)",
     "legendFormat": "__auto",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "id": 7,
   "title": "Browser errors (1 h)",
   "description": "Uncaught JS errors and unhandled rejections reported by browsers.",
