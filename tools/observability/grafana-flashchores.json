     },
     "expr": "process_cpu_usage",
     "legendFormat": "__auto",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "id": 13,
   "title": "DB connections in use",
   "description": "Pool max is 2. Pending > 0 (see Database row) means requests are queueing for a connection.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 20,
    "y": 5
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
