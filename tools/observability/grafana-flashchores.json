   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "vaadin_ui_state_nodes_max",
     "legendFormat": "__auto",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "id": 11,
   "title": "Sessions created (24 h)",
   "description": "New server sessions in the last day. Includes bots and health checks.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 12,
    "y": 5
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
