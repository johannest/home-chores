  },
  {
   "type": "stat",
   "id": 10,
   "title": "Worst tab (state nodes)",
   "description": "Largest component tree any single open tab holds. It is the tail that exhausts a heap, not the mean.",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 8,
    "y": 5
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "auto",
    "orientation": "auto"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
